DATABASE_URL="file:./dev.db"
PORT=4100
CORS_ORIGIN="http://localhost:5190"

# Marketing por correo a adjudicatarios (ver docs/estrategia-email-marketing.md).
# Sin SMTP_HOST/SMTP_USER/SMTP_PASS, el envío se SIMULA (log en consola) — no sale nada real
# hasta que configures tu propia cuenta de correo aquí.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Identidad del remitente en la plantilla del correo — sin valor por defecto real, el correo
# muestra un placeholder visible ("[Falta configurar ...]") mientras no los llenes.
EMPRESA_NOMBRE=
EMPRESA_TELEFONO=

# Cuántas horas esperar tras el correo inicial antes de mandar el recordatorio (default 30).
HORAS_RECORDATORIO_MARKETING=30

# Días sin ningún seguimiento comercial antes de descartar un lead automáticamente (default 3).
DIAS_SIN_SEGUIMIENTO=3

# Tope de leads NUEVOS por día, para poder trabajarlos al detalle (default 80).
CUPO_DIARIO_LEADS=80
